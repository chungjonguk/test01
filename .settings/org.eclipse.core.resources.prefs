encoding//src/main/resources/application-local.properties=UTF-8
encoding//src/main/resources/application-prod.properties=UTF-8
encoding//src/main/resources/application-mobile.properties=UTF-8
encoding/*.properties=UTF-8
encoding/*.html=UTF-8
encoding/*.xml=UTF-8
encoding/*.java=UTF-8
encoding/*.js=UTF-8
encoding/*.css=UTF-8
encoding/src/main/java=UTF-8
encoding/src/main/resources=UTF-8
encoding/src/test/java=UTF-8
