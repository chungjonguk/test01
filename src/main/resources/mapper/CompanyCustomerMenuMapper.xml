<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootapp.mapper.CompanyCustomerMenuMapper">

    <resultMap id="companyCustomerMenuMap" type="CompanyCustomerMenu">
        <id property="companyId" column="company_id"/>
        <id property="menuPath" column="menu_path"/>
        <result property="useYn" column="use_yn"/>
        <result property="sortOrd" column="sort_ord"/>
        <result property="regId" column="reg_id"/>
        <result property="regDt" column="reg_dt"/>
        <result property="updateId" column="update_id"/>
        <result property="updateDt" column="update_dt"/>
    </resultMap>

    <select id="listByCompanyId" resultMap="companyCustomerMenuMap">
        SELECT company_id, menu_path, use_yn, sort_ord, reg_id, reg_dt, update_id, update_dt
        FROM company_customer_menu
        WHERE company_id = #{companyId} AND use_yn = 'Y'
        ORDER BY sort_ord, menu_path
    </select>

    <delete id="deleteByCompanyId">
        DELETE FROM company_customer_menu WHERE company_id = #{companyId}
    </delete>

    <insert id="insert">
        INSERT INTO company_customer_menu (company_id, menu_path, use_yn, sort_ord, reg_id, update_id)
        VALUES (#{companyId}, #{menuPath}, #{useYn}, #{sortOrd}, #{regId}, #{updateId})
    </insert>
</mapper>
