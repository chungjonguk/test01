<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootapp.mapper.EcmCustomerMapper">

    <resultMap id="ecmCustomerResultMap" type="EcmCustomer">
        <id property="customerId" column="customer_id"/>
        <result property="customerNm" column="customer_nm"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="zipcode" column="zipcode"/>
        <result property="address" column="address"/>
        <result property="addressDetail" column="address_detail"/>
    </resultMap>

    <select id="findById" resultMap="ecmCustomerResultMap">
        SELECT customer_id, customer_nm, email, phone, zipcode, address, address_detail
        FROM ecm_customer
        WHERE customer_id = #{customerId}
    </select>

    <resultMap id="ecmCustomerListItemMap" type="com.example.springbootapp.dto.EcmCustomerListItem">
        <result property="customerId" column="customer_id"/>
        <result property="customerNm" column="customer_nm"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="regDt" column="reg_dt"/>
    </resultMap>

    <select id="searchCustomers" resultMap="ecmCustomerListItemMap">
        SELECT customer_id, customer_nm, email, phone,
               TRIM(CONCAT_WS(' ', address, address_detail)) AS address,
               reg_dt
        FROM ecm_customer
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    customer_nm LIKE CONCAT('%', #{keyword}, '%')
                    OR email LIKE CONCAT('%', #{keyword}, '%')
                    OR phone LIKE CONCAT('%', #{keyword}, '%')
                    OR address LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
        </where>
        ORDER BY reg_dt DESC, customer_id DESC
        LIMIT 500
    </select>
</mapper>
